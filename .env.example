# ==============================================================================
# DATABASE ENGINE CONFIGURATION
# ==============================================================================
# Supported drivers:
#   - sqlite (default) : Embedded file storage via better-sqlite3 (SQLITE_DB_PATH).
#   - mysql            : Network RDBMS client via mysql2 pool.
#
# Runtime Behavior:
#   - Set STORAGE_ENGINE to 'sqlite' or 'mysql'.
#   - Auto-failover: If MySQL connection handshake fails, driver falls back to SQLite.
# ==============================================================================

# ==========================================
# 1) STORAGE ENGINE TOGGLE
# ==========================================
# Active Default (Zero-setup local SQLite):
STORAGE_ENGINE=sqlite

# To enable MySQL instead: uncomment the following line and comment out the line above:
# STORAGE_ENGINE=mysql

# ==========================================
# 2) APPLICATION & SERVER SETTINGS
# ==========================================
PORT=8080
NODE_ENV=development

# ==========================================
# 3) SQLITE STORAGE SETTINGS (Used when STORAGE_ENGINE=sqlite)
# ==========================================
SQLITE_DB_PATH=./data/ppu_complaints.db

# ==========================================
# 4) MYSQL STORAGE SETTINGS (Used when STORAGE_ENGINE=mysql)
# ==========================================
# To use MySQL: remove `#` from the following 6 lines and adjust credentials:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=ppu_complaints
# DB_CONNECTION_LIMIT=10

# ==========================================
# 5) SECURITY & DEFAULT SUPER ADMIN SEEDING
# ==========================================
# JWT Secret Key for Admin Sessions
JWT_SECRET=ppu_complaints_super_secret_jwt_key_2026_palestine

# Default Admin Account (Auto-created on first run with bcrypt hash)
ADMIN_DEFAULT_NAME=مسؤول النظام الجامعي
ADMIN_DEFAULT_EMAIL=admin@ppu.edu.ps
ADMIN_DEFAULT_PASSWORD=adminPPU2026!

# Uploads directory for complaint photo attachments
UPLOAD_DIR=./uploads

# Base Application URL (used for links in emails and WhatsApp messages)
APP_URL=http://localhost:8080

# ==========================================
# 6) EMAIL & SMTP SERVER CONFIGURATION
# ==========================================
# Set to 'true' to print email payloads to stdout console during local development/tests
ENABLE_EMAIL_CONSOLE_LOG=true

# Set ENABLE_SMTP=true to enable actual email delivery via Nodemailer SMTP
ENABLE_SMTP=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="نظام الشكاوى - جامعة بوليتكنك فلسطين" <complaints@ppu.edu.ps>
SMTP_REPLY_TO=complaints@ppu.edu.ps

