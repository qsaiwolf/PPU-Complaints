# ==============================================================================
# 🎯 DATABASE SELECTION & CONFIGURATION GUIDE
# ==============================================================================
# The PPU Complaints System supports dual database storage engines out of the box:
#
# ------------------------------------------------------------------------------
# 🟢 OPTION 1: Zero-Config Embedded Database (SQLite) — [DEFAULT]
# ------------------------------------------------------------------------------
# - Runs instantly without installing external services (no MySQL / XAMPP needed).
# - Stores all data in a standalone local database file at `./data/ppu_complaints.db`.
# - How to use:
#     Keep `STORAGE_ENGINE=sqlite` active (no # in front).
#     Keep MySQL settings commented out with `#`.
#
# ------------------------------------------------------------------------------
# 🔵 OPTION 2: Enterprise Relational Database (MySQL)
# ------------------------------------------------------------------------------
# - Connects to an external MySQL server (via XAMPP, Docker, Cloud, or Localhost).
# - Make sure you have created a database named `ppu_complaints` (or custom name).
# - How to use:
#     1) Comment out SQLite: add `#` in front of `STORAGE_ENGINE=sqlite`
#     2) Uncomment MySQL: remove `#` from `STORAGE_ENGINE=mysql`
#     3) Uncomment MySQL connection fields below (DB_HOST, DB_USER, DB_PASSWORD, etc.)
#
# ------------------------------------------------------------------------------
# ⚡ SMART AUTO-FAILOVER RESILIENCE
# ------------------------------------------------------------------------------
# If you set STORAGE_ENGINE=mysql but your MySQL server is unreachable or offline,
# the system automatically and safely falls back to local SQLite so your app never crashes!
# ==============================================================================

# ==========================================
# 1) STORAGE ENGINE TOGGLE
# ==========================================
# Active Default (Zero-setup local SQLite):
STORAGE_ENGINE=sqlite

# To enable MySQL instead: uncomment the following line and comment out the line above:
# STORAGE_ENGINE=mysql

# ==========================================
# 2) APPLICATION & SERVER SETTINGS
# ==========================================
PORT=8080
NODE_ENV=development

# ==========================================
# 3) SQLITE STORAGE SETTINGS (Used when STORAGE_ENGINE=sqlite)
# ==========================================
SQLITE_DB_PATH=./data/ppu_complaints.db

# ==========================================
# 4) MYSQL STORAGE SETTINGS (Used when STORAGE_ENGINE=mysql)
# ==========================================
# To use MySQL: remove `#` from the following 6 lines and adjust credentials:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=ppu_complaints
# DB_CONNECTION_LIMIT=10

# ==========================================
# 5) SECURITY & DEFAULT SUPER ADMIN SEEDING
# ==========================================
# JWT Secret Key for Admin Sessions
JWT_SECRET=ppu_complaints_super_secret_jwt_key_2026_palestine

# Default Admin Account (Auto-created on first run with bcrypt hash)
ADMIN_DEFAULT_NAME=مسؤول النظام الجامعي
ADMIN_DEFAULT_EMAIL=admin@ppu.edu.ps
ADMIN_DEFAULT_PASSWORD=adminPPU2026!

# Uploads directory for complaint photo attachments
UPLOAD_DIR=./uploads

# Simulated email notification logger (Prints outgoing emails to terminal console)
ENABLE_EMAIL_CONSOLE_LOG=true
